{
  "name": "cursor-cloud-mcp",
  "version": "0.1.0",
  "description": "MCP server for Cursor Cloud Agents. Companion to Cursor for Android.",
  "type": "module",
  "license": "MIT",
  "author": "Bennett Buhner <136861830+BenItBuhner@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenItBuhner/Cursor-Cloud-MCP.git"
  },
  "homepage": "https://github.com/BenItBuhner/Cursor-Cloud-MCP#readme",
  "bugs": {
    "url": "https://github.com/BenItBuhner/Cursor-Cloud-MCP/issues"
  },
  "bin": {
    "cursor-cloud-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "http": "node build/http.js",
    "login": "node build/cli.js login",
    "logout": "node build/cli.js logout",
    "status": "node build/cli.js status",
    "dev": "npx tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "dotenv": "^17.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
