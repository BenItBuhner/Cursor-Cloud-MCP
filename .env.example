# Cursor API key (documented Cloud Agents API). Get one at https://cursor.com/dashboard/api
CURSOR_API_KEY=
# Optional: default to Extended mode (unofficial api2.cursor.sh account endpoints). Off by default.
#CURSOR_EXTENDED_MODE=1
# Optional: override API hosts (defaults match the Android app + docs)
#CURSOR_API_BASE_URL=https://api.cursor.com/
#CURSOR_ACCOUNT_API_URL=https://api2.cursor.sh
#CURSOR_WEBSITE_URL=https://cursor.com
# Optional: HTTP transport port
#PORT=8091
